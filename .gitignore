# ====================================================================
# 1. ARCHIVOS TEMPORALES Y COMPILACIÓN DE ANDROID / GRADLE
# ====================================================================
.gradle/
/build/
/*/build/
/captures/
.externalNativeBuild/
.cxx/
*.iml
*.apk
*.aar

# ====================================================================
# 2. CONFIGURACIÓN LOCAL (Específica de tu PC)
# ====================================================================
local.properties
/local.properties
.DS_Store
Thumbs.db

# ====================================================================
# 3. ANDROID STUDIO / IDE (Ignorar toda la carpeta .idea de forma limpia)
# ====================================================================
/.idea/
.idea/
*.ipr
*.iws

# Evita subir perfiles de hardware del emulador local
/captures/
*.keystore
# Excepción por si acaso usas firmas embebidas (descomentar solo si es necesario)
# !debug.keystore

# ====================================================================
# 4. SEGURIDAD, LLAVES PRIVADAS Y CREDENCIALES (CRÍTICO)
# ====================================================================
# Bloquea tokens específicos de mapas
app/src/main/res/values/mapbox_access_token.xml

# Bloquea la carpeta completa de tus llaves de Firebase de producción
app/credentials/
**/credentials/

# Bloquea archivos de variables de entorno locales donde guardes API Keys
.env
.env.*

# ====================================================================
# 5. BACKEND / FIREBASE FUNCTIONS (Si usas Typescript/Javascript)
# ====================================================================
functions/node_modules/
functions/.runtimeconfig.json
functions/lib/
.firebase/

# ====================================================================
# 6. LOGS, REPORTES DE ERRORES Y BASURA DEL SISTEMA
# ====================================================================
*.log
hs_err_pid*
replay_pid*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ====================================================================
# 7. ASISTENTES DE IA / AGENTES (Opcional - carpetas de skills locales)
# ====================================================================
.agents/